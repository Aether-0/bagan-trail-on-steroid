{
  "manifest_version": 3,
  "name": "Bagan-Trail on Steroid",
  "version": "1.0.1",
  "description": "A BaganTrail horse mod menu, made with love by Aether.",
  "icons": {
    "16": "assets/icons/extension-16.png",
    "32": "assets/icons/extension-32.png",
    "48": "assets/icons/extension-48.png",
    "128": "assets/icons/extension-128.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://bagantrail.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bagan-Trail on Steroid",
    "default_icon": {
      "16": "assets/icons/extension-16.png",
      "32": "assets/icons/extension-32.png",
      "48": "assets/icons/extension-48.png"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/brand-mark.svg", "assets/icons/*.svg"],
      "matches": ["https://bagantrail.com/*"]
    }
  ]
}
